DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# --- Database: mssql (default) or sqlite (quick local try-out) ---
DB_ENGINE=sqlite
MSSQL_DB=kb_hub
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Set to 1 for Windows authentication (then USER/PASSWORD are ignored)
MSSQL_TRUSTED=0

# --- Embeddings / vector DB ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=hash   # offline, no model download (low quality, for tests)

# --- LLM (any OpenAI-compatible endpoint). Default: local Ollama ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
# Free API example (Groq): LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant  LLM_API_KEY=gsk_...
# Set LLM_ENABLED=0 to use the built-in heuristic extractor only
LLM_ENABLED=1

# --- Scraper ---
SCRAPE_WORKERS=8
SCRAPE_TIMEOUT=20
